# ──────────────────────────────────────────────────────────────
# Coderefine Backend — Environment Variables
# Copy this file to .env for local development.
# Set these as environment variables in your Render dashboard
# for production deployment.
# ──────────────────────────────────────────────────────────────

# Groq AI API key — get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Supabase project URL — from your Supabase project settings
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key — from your Supabase project settings
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Comma-separated list of allowed CORS origins.
# For local dev, leave unset or use * (the default).
# For production, set to your Vercel frontend URL:
# ALLOWED_ORIGINS=https://your-project.vercel.app
ALLOWED_ORIGINS=*
